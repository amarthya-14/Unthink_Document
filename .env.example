# Which AI provider to use for summarization: "gemini" (default, recommended)
# or "groq" (faster, slightly lower quality on free-tier models).
VITE_AI_PROVIDER=gemini

# Gemini — get a free key at https://aistudio.google.com/apikey (no card required)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: force a specific Gemini model if auto-discovery picks the wrong one.
# The app normally detects the best available Flash model automatically.
# VITE_GEMINI_MODEL=gemini-3.6-flash

# Groq — only needed if VITE_AI_PROVIDER=groq. Free key at https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key_here

# Optional: force a specific Groq model if the built-in fallback list gets stale.
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer YOUR_KEY"
# VITE_GROQ_MODEL=llama-3.3-70b-versatile
